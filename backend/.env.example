# Configuração do Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deliveryvip_db?schema=public"

# Autenticação JWT
JWT_SECRET=deliveryvip_jwt_super_secret_key_2026
JWT_REFRESH_SECRET=deliveryvip_jwt_refresh_secret_key_2026
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef # 32 bytes hex key para AES-256

# Configuração Padrão da API DeliveryVip (MOCK / PRODUÇÃO)
DELIVERYVIP_API_URL=http://localhost:3001
DELIVERYVIP_CLIENT_ID=default_client_id
DELIVERYVIP_CLIENT_SECRET=default_client_secret
DELIVERYVIP_MERCHANT_ID=default_merchant_uuid
